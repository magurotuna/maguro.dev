{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maguro-dev",
  "compatibility_date": "2026-10-03",
  // Static assets only: Astro renders pages and OGP images at build time.
  // No production routes/custom domains until the cutover is approved.
  "assets": {
    "directory": "./dist-cloudflare",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Required by Workers Builds' `wrangler preview`; assets stay at the top level.
  "previews": {},
}
