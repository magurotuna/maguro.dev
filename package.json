{
  "name": "maguro-dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "tsx scripts/generate-redirects.ts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "refresh-link-cache": "tsx scripts/link-cards.ts --refresh",
    "link-cards:strict": "tsx scripts/link-cards.ts --strict",
    "test:redirects": "tsx scripts/smoke-test-redirects.ts",
    "test:archive-noindex": "tsx scripts/smoke-test-archive-noindex.ts",
    "test:screenshots": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:cloudflare": "node --import tsx scripts/generate-redirects.ts && astro build --outDir dist-cloudflare && node scripts/prepare-cloudflare.mjs",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev --local",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "check:cloudflare": "npm run build:cloudflare && npm run test:resume && npm run test:cloudflare:unit && npm run test:cloudflare:routing",
    "test:resume": "node --test scripts/build-resume.test.mjs",
    "test:cloudflare:unit": "node --test scripts/prepare-cloudflare.test.mjs",
    "test:cloudflare:routing": "node --test scripts/cloudflare-routing.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@resvg/resvg-js": "^2.6.2",
    "@types/hast": "^3.0.5",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "budoux": "^0.7.0",
    "gray-matter": "^4.0.3",
    "html-entities": "^2.5.0",
    "katex": "^0.16.47",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.18.4",
    "tsx": "^4.23.15",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.0.0",
    "wrangler": "^4.147.0"
  }
}
